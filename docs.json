{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vocal",
  "description": "Help for Vocal, the AI-native business phone: calls, texts, numbers, CRM, Iris, and billing.",
  "colors": {
    "primary": "#1A6EFF",
    "light": "#3D85FF",
    "dark": "#1A6EFF"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#080808"
    }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": {
    "light": "/images/mark-white.svg",
    "dark": "/images/mark-black.svg"
  },
  "logo": {
    "light": "/images/mark-black.svg",
    "dark": "/images/mark-white.svg",
    "href": "https://support.vocal.solutions"
  },
  "fonts": {
    "family": "Inter"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "getting-started/quickstart",
          "getting-started/how-vocal-works"
        ]
      },
      {
        "group": "Calls and texts",
        "pages": [
          "inbox",
          "calls/calling",
          "messaging/texting",
          "calls/voicemail",
          "contacts"
        ]
      },
      {
        "group": "CRM for recruiters",
        "pages": [
          "crm/getting-started",
          "crm/importing-leads",
          "crm/calling",
          "crm/follow-ups",
          "crm/texting",
          "crm/details-and-notes",
          "crm/privacy-and-stopping",
          "crm/troubleshooting"
        ]
      },
      {
        "group": "Understand your business",
        "pages": [
          "iris",
          "calls/analytics",
          "calls/recording"
        ]
      },
      {
        "group": "Your team",
        "pages": [
          "team/members-and-roles",
          "team/groups"
        ]
      },
      {
        "group": "Numbers and routing",
        "pages": [
          "numbers/get-a-number",
          "numbers/porting",
          "numbers/sms-registration",
          "calls/call-flows",
          "calls/ringing-your-team"
        ]
      },
      {
        "group": "Apps and integrations",
        "pages": [
          "apps/desktop",
          "integrations/overview"
        ]
      },
      {
        "group": "Billing",
        "pages": [
          "billing/plans"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/faq",
          "help/emergency-calls"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/calls/ring-groups",
      "destination": "/calls/ringing-your-team"
    },
    {
      "source": "/agent/lola",
      "destination": "/"
    },
    {
      "source": "/agent/behavior",
      "destination": "/"
    },
    {
      "source": "/agent/voice",
      "destination": "/"
    },
    {
      "source": "/agent/knowledge",
      "destination": "/"
    },
    {
      "source": "/agent/workflow",
      "destination": "/"
    },
    {
      "source": "/campaigns/outbound",
      "destination": "/"
    },
    {
      "source": "/numbers/number-pools",
      "destination": "/"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "vocal.solutions",
        "href": "https://www.vocal.solutions"
      },
      {
        "label": "Log in",
        "href": "https://app.vocal.solutions/sign-in"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start free",
      "href": "https://app.vocal.solutions/sign-up"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "indexing": "all"
  }
}
